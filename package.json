{
  "name": "medidesk-pos",
  "version": "1.1.0",
  "description": "Production-ready, offline-first Desktop POS & Inventory Management software for retail pharmacies",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --ia32 --x64",
    "build:win32": "electron-builder --win nsis --ia32",
    "build:win64": "electron-builder --win nsis --x64"
  },
  "keywords": [
    "pos",
    "pharmacy",
    "electron",
    "sqlite",
    "inventory"
  ],
  "author": "Syed Bilal",
  "license": "MIT",
  "dependencies": {
    "sql.js": "^1.12.0"
  },
  "devDependencies": {
    "electron": "22.3.27",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.syedbilal.medideskpos",
    "productName": "MediDesk POS",
    "win": {
      "icon": "icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "ia32",
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "ia32",
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
